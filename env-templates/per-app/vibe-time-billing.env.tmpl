# vibe-time-billing.env.tmpl — rendered to /opt/vibe/env/vibe-time-billing.env
# by lib/enable-app.sh. App: Vibe Practice Management
# (github.com/KisaesDevLab/Vibe-Time-Billing).
#
# The api refuses to boot without KMS_KEY and both realm JWT secrets —
# all three are generated once on first enable and PRESERVED on every
# re-render (rotating KMS_KEY in place loses every wrapped data key).

NODE_ENV=production
LOG_LEVEL=info

# --- Routing identity -------------------------------------------------
# rootServedOnly app: served at the root of its own subdomain in BOTH
# routing modes, so APP_BASE_URL is https://practice.<your-domain> in
# domain mode. PORTAL_BASE_URL is the client-portal realm's own host —
# invitation emails, view-as links, and proposal magic links embed it,
# so pointing it at the staff host would auth-gate clients into a login
# they can't pass.
APP_BASE_URL=@ALLOWED_ORIGIN@
PORTAL_BASE_URL=@CLIENT_PORTAL_URL@

# --- Database + Redis (shared appliance instances) --------------------
DATABASE_URL=@DATABASE_URL@
REDIS_URL=@REDIS_URL@

# --- Realm secrets (generated once, preserved forever) ----------------
STAFF_JWT_SECRET=@STAFF_JWT_SECRET@
PORTAL_JWT_SECRET=@PORTAL_JWT_SECRET@
# 32 raw bytes, base64. Envelope-encryption master key. NOT ROTATABLE IN
# PLACE — losing or changing it loses every wrapped data key. Lives here
# (mode 600) inside the appliance's sealed backup set.
KMS_KEY=@KMS_KEY@
PROPOSAL_SIGNATURE_HMAC_SEED=@PROPOSAL_SIGNATURE_HMAC_SEED@

# --- First-run seed (read ONCE by the run-once seed; see manifest) ----
# Set FIRM_NAME and ADMIN_EMAIL to real values BEFORE the first enable —
# the seed runs exactly once (state.apps.vibe-time-billing.seeded gates
# it), so changing them later creates nothing and the original admin
# stays. Sign-in requires working email (magic link / emailed one-time
# code), so ADMIN_EMAIL must be a mailbox you can read.
FIRM_NAME=My CPA Firm
ADMIN_EMAIL=admin@appliance.local
ADMIN_NAME=Firm Administrator
ADMIN_PASSWORD=@ADMIN_PASSWORD@

# --- Document storage -------------------------------------------------
# mock is EVALUATION ONLY: uploaded documents are not durable and vanish
# on restart. Before storing real client documents, create a firm-owned
# Backblaze B2 bucket, fill in the B2_* values (Settings page → this
# app → Storage, or edit here), and set STORAGE_PROVIDER=b2. The api
# refuses to boot with STORAGE_PROVIDER=b2 while any B2_* is missing —
# that error is loud and names the missing field.
STORAGE_PROVIDER=mock
B2_ENDPOINT=
B2_REGION=
B2_BUCKET=
B2_KEY_ID=
B2_APPLICATION_KEY=

# --- Email (REQUIRED before first sign-in) ----------------------------
# Password sign-in is completed with an emailed one-time code, and the
# magic-link flow is email too — with no working relay nobody can log
# in. Providers: smtp | postmark | resend | ses | emailit (see the
# upstream .env.example for the provider-specific variables).
MAIL_PROVIDER=smtp
MAIL_FROM=
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_SMTP_SECURE=false
MAIL_SMTP_USER=
MAIL_SMTP_PASS=

# --- SMS (optional) ---------------------------------------------------
# Used for texted one-time codes and client notifications when set up.
# Providers: textlink | twilio | sns.
SMS_PROVIDER=textlink
# SMS_TEXTLINK_API_KEY=

# --- Passkeys (optional) ----------------------------------------------
# WEBAUTHN_RP_ID must be the bare staff hostname (no scheme), e.g.
# practice.firm.com. Leave blank until the firm's domain is final;
# WEBAUTHN_ORIGIN defaults to APP_BASE_URL upstream.
# WEBAUTHN_RP_ID=
WEBAUTHN_RP_NAME=Vibe Practice Management

# --- Vibe AI Router (dual-mode) ---------------------------------------
# Rendered by `vibe enable`: mode becomes "router" with a minted app
# token when vibe-ai-router is enabled and healthy at enable time;
# otherwise "direct" (re-enable this app after the router is up to
# switch). Router mode moves model choice, scrubbing, budgets, and cost
# tracking to the router console.
VIBE_AI_MODE=@VIBE_AI_MODE@
VIBE_AI_ROUTER_URL=http://vibe-ai-router:8220
VIBE_AI_TOKEN=@VIBE_AI_TOKEN@

# --- Deliberately NOT wired (appliance owns this infra) ---------------
# The app's standalone installer provisions its own Cloudflare tunnel,
# backup sidecar, and recovery kit. On the appliance those are owned by
# the platform (Settings → Network, Duplicati), so the variables stay
# unset and the in-app pages for them report the feature unavailable.
# CLOUDFLARED_TOKEN_FILE / CLOUDFLARED_METRICS_URL — unset on purpose.
#
# OpenSign e-signature is an upstream-standalone opt-in (AGPL boundary:
# it runs as unmodified images on its own network, never composed here).
# Native signing is the default. To point at a standalone deployment:
# OPENSIGN_URL=
# OPENSIGN_APP_ID=opensign
# OPENSIGN_MASTER_KEY=
# OPENSIGN_API_EMAIL=
# OPENSIGN_API_PASSWORD=
# OPENSIGN_WEBHOOK_SECRET=
#
# Document-intake virus scanning (off when CLAMD_HOST is empty):
# CLAMD_HOST=
# CLAMD_PORT=3310
#
# Portal PWA web-push (generate once: npx web-push generate-vapid-keys):
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:support@example.com
