# vibe-recap.env.tmpl — rendered to /opt/vibe/env/vibe-recap.env by lib/enable-app.sh.
# Copy of Vibe-Recap/.appliance/vibe-recap.env.tmpl; the app repo is the source of truth.
#
# Vibe Recap turns a finished Form 1040 package into a narrated video summary for the
# client. Four containers share this file: the api, the migration one-shot, the worker, and
# (env only, unused) the web tier. See apps/vibe-recap.yml for the service graph and why the
# worker sits behind a relay instead of on vibe_net.
#
# KEY MATERIAL IS NOT IN THIS FILE. The blob-store master key is created by the api on first
# start at /data/keys/master.key (/opt/vibe/data/apps/vibe-recap/keys) and every stored file
# is wrapped under it. Back up /opt/vibe/data/apps/vibe-recap together with this env; the
# blobs are unreadable without keys/. MASTER_KEY_PASSPHRASE below is optional wrapping.

NODE_ENV=production
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
DATA_DIR=/data
COOKIE_SECURE=true
TRUST_PROXY=true
ALLOWED_ORIGIN=@ALLOWED_ORIGIN@

# --- Storage (per-app role on shared Postgres; Redis index 9) ---------------------------
DATABASE_URL=@DATABASE_URL@
REDIS_URL=@REDIS_URL@

# --- Migrations: explicit, never at boot on the appliance -------------------------------
MIGRATIONS_AUTO=false

# --- First admin (seed runs once; no-op after any user exists) --------------------------
SEED_ADMIN_EMAIL=admin@appliance.local
SEED_ADMIN_NAME=Administrator
SEED_ADMIN_PASSWORD=@SEED_ADMIN_PASSWORD@

# --- Vibe AI Router (default script provider) -------------------------------------------
# Minted against the router's admin API during enable and preserved across re-renders.
# The task class `recap_script` is registered by the api at startup and starts local_only;
# widen it in the router console (Policies) to let cloud models serve it. Only the extracted
# figures, first names, filing status, states and the preparer's note ever leave the box;
# the return PDF does not. Empty token = scripts are generated on the local model server.
VIBE_AI_ROUTER_URL=http://vibe-ai-router:8220
VIBE_AI_TOKEN=@VIBE_AI_TOKEN@

# --- Local model server (fallback provider and OCR) -------------------------------------
# The worker reaches this through vibe-recap-relay under the same name. OCR of scanned pages
# needs an Ollama-native endpoint (/api/chat with images); if the local server only speaks
# /v1, scanned packages fail cleanly at the `ocr` step.
OLLAMA_URL=http://vibellm:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_OCR_MODEL=glm-ocr
OLLAMA_TIMEOUT_S=600

# --- Processing -------------------------------------------------------------------------
WORKER_CONCURRENCY=1
FORM_PROFILES_DIR=/data/form-profiles

# --- Kisaes licensing (informational until the licensing server is live) ----------------
LICENSE_SERVER_URL=https://licensing.kisaes.com
LICENSE_ENFORCE=false

# --- Optional -----------------------------------------------------------------------------
MASTER_KEY_PASSPHRASE=
