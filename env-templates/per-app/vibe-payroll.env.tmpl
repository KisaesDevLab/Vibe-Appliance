# vibe-payroll.env.tmpl — rendered to /opt/vibe/env/vibe-payroll.env
# by lib/enable-app.sh.

NODE_ENV=production

ALLOWED_ORIGIN=@ALLOWED_ORIGIN@
# Vibe-Payroll's backend reads CORS_ORIGIN, not ALLOWED_ORIGIN. Set both.
CORS_ORIGIN=@ALLOWED_ORIGIN@
DATABASE_URL=@DATABASE_URL@
REDIS_URL=@REDIS_URL@

# Vibe-Payroll's backend env validator requires SECRETS_ENCRYPTION_KEY
# (separate from ENCRYPTION_KEY despite the name). Mirror the shared
# encryption key under that alias so we don't generate a parallel
# secret the operator has to know about.
SECRETS_ENCRYPTION_KEY=@ENCRYPTION_KEY@

# The web image's /docker-entrypoint.d/40-base-path.sh sed-substitutes
# the SPA's `/__VIBE_BASE_PATH__/` sentinel with this value. Has to
# match the Caddy path prefix exactly (or the SPA's <script src>'s
# load from the wrong path and 404).
VITE_BASE_PATH=@VITE_BASE_PATH@

MIGRATIONS_AUTO=true

# --- Single sign-on (Vibe Auth) ---------------------------------------
# Registration (console Identity panel → Register/Fix, or `sudo vibe
# identity register vibe-payroll`) appends the broker's VIBE_OIDC_ISSUER /
# _INTERNAL_BASE / _CLIENT_ID / _CLIENT_SECRET / _PUBLIC_URL / _IDP_NAME
# block below and provisions the app's vibe-breakglass admin; the
# Identity panel's mode dropdown writes VIBE_AUTH_MODE (local | both |
# oidc_only). Neither is set here: a fresh enable runs on local sign-in
# (Vibe Auth D11). Requires a Vibe-Payroll-Time release containing PR #3.
#
# ORDER MATTERS: finish the app's first-run /setup wizard BEFORE
# registering. The app refuses to provision break-glass into a database
# that has not been set up (any SuperAdmin row locks its setup wizard for
# ever), and register swallows that failure — so after /setup, run
# `sudo vibe identity register vibe-payroll` again.
#
# Staff realm only: kiosk pairing and PIN / badge punches never go
# through SSO, in any mode.
#
# The app has no second factor of its own, so the identity provider's MFA
# is the only one an SSO session gets. Operator-adjustable on the
# Settings → Apps tab together with VIBE_OIDC_ALLOW_JIT /
# VIBE_OIDC_DEFAULT_ROLE / VIBE_OIDC_ROLE_MAP (manifest ui blocks);
# registration never touches these four.
VIBE_OIDC_REQUIRE_MFA_AMR=true

# --- Optional knobs ---
# (Vibe Payroll uses a state-tax-table provider that the operator can
# pin via STATE_TAX_PROVIDER once that PR lands upstream.)

# --- Vibe AI Router (dual-mode, MIG-7) ---
# Rendered by `vibe enable`: mode becomes "router" with a minted app token
# when the vibe-ai-router app is enabled and healthy at enable time;
# otherwise "direct" (re-enable this app after the router is up to switch).
# router mode moves model choice, scrubbing, budgets, and cost tracking to
# the router console; the app's own AI provider settings become inert.
VIBE_AI_MODE=@VIBE_AI_MODE@
VIBE_AI_ROUTER_URL=http://vibe-ai-router:8220
VIBE_AI_TOKEN=@VIBE_AI_TOKEN@
