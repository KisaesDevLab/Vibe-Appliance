# vibe-auth.env.tmpl — rendered to /opt/vibe/env/vibe-auth.env by
# lib/enable-app.sh. Consumed by the broker (vibe-auth) AND the bundled
# authentik server/worker (same env file, see apps/vibe-auth.yml).
#
# Secrets below are generated once and preserved on every re-render
# (manifest env[].from = generated:hex32). Rotating VIBE_AUTH_SECRET_KEY
# orphans every stored product client secret — re-register products
# from the console Identity panel ("Fix") if that ever happens.

# --- Broker routing identity ---------------------------------------------
# @ALLOWED_ORIGIN@ is this app's browser origin for the current mode
# (https://auth.<domain> in subdomain-per-app, https://<tunnel>.<domain>
# in single-host, http://<ip> in LAN). The broker derives host/routing
# from these two values; https is always used for sign-in URLs because
# Caddy serves :443 in every mode (LAN = internal CA).
VIBE_AUTH_APPLIANCE_ORIGIN=@ALLOWED_ORIGIN@
VIBE_AUTH_APPLIANCE_MODE=@ROUTING_MODE@:@DOMAIN_ROUTING_MODE@
VIBE_AUTH_BASE_PATH=@VITE_BASE_PATH@
VIBE_AUTH_AUTHENTIK_PATH=/auth/
VIBE_AUTH_AUTHENTIK_INTERNAL=http://vibe-auth-authentik-server:9000
VIBE_AUTH_PORT=8080
VIBE_AUTH_HOST=appliance

# --- Database (per-app role on the shared Postgres, D7) -------------------
VIBE_AUTH_DATABASE_URL=@DATABASE_URL@
VIBE_AUTH_PG_MODE=shared

# --- Secrets (generated once, preserved) ----------------------------------
VIBE_AUTH_AUTHENTIK_SECRET_KEY=@VIBE_AUTH_AUTHENTIK_SECRET_KEY@
VIBE_AUTH_AUTHENTIK_TOKEN=@VIBE_AUTH_AUTHENTIK_TOKEN@
VIBE_AUTH_CONSOLE_TOKEN=@VIBE_AUTH_CONSOLE_TOKEN@
VIBE_AUTH_SECRET_KEY=@VIBE_AUTH_SECRET_KEY@

# --- authentik (reads the same file) --------------------------------------
AUTHENTIK_SECRET_KEY=@VIBE_AUTH_AUTHENTIK_SECRET_KEY@
AUTHENTIK_POSTGRESQL__HOST=@DB_HOST@
AUTHENTIK_POSTGRESQL__PORT=@DB_PORT@
AUTHENTIK_POSTGRESQL__NAME=@DB_NAME@
AUTHENTIK_POSTGRESQL__USER=@DB_USER@
AUTHENTIK_POSTGRESQL__PASSWORD=@DB_PASSWORD@
# API token for the broker; no bootstrap password → akadmin has no usable password (D13).
AUTHENTIK_BOOTSTRAP_TOKEN=@VIBE_AUTH_AUTHENTIK_TOKEN@
AUTHENTIK_BOOTSTRAP_EMAIL=akadmin@localhost
AUTHENTIK_WEB__PATH=/auth/
AUTHENTIK_DISABLE_UPDATE_CHECK=true
AUTHENTIK_DISABLE_STARTUP_ANALYTICS=true
AUTHENTIK_ERROR_REPORTING__ENABLED=false
AUTHENTIK_EMAIL__HOST=
AUTHENTIK_EMAIL__PORT=587
AUTHENTIK_EMAIL__USERNAME=
AUTHENTIK_EMAIL__PASSWORD=
AUTHENTIK_EMAIL__USE_TLS=true
AUTHENTIK_EMAIL__FROM=vibe-auth@localhost

# --- Optional knobs (Settings page / 'sudo nano /opt/vibe/env/vibe-auth.env') ---
VIBE_AUTH_BRAND_NAME=Vibe Auth
VIBE_AUTH_MFA_REQUIRED=true
# VIBE_AUTH_SMTP_HOST=
# VIBE_AUTH_SENTINEL_URL=
# VIBE_AUTH_SENTINEL_TOKEN=

# --- Break-glass passwords (secret store, D12) ----------------------------
# lib/identity.sh appends VIBE_BREAKGLASS_PASSWORD_<SLUG>=... here when it
# provisions a product's vibe-breakglass admin. Shown once in the console
# and in /opt/vibe/CREDENTIALS.txt. Rotate: vibe identity rotate-breakglass <slug>.
