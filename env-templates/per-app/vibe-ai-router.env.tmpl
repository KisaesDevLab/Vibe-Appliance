# vibe-ai-router.env.tmpl — rendered to /opt/vibe/env/vibe-ai-router.env by
# lib/enable-app.sh.
#
# Vibe AI Router = the suite's sole AI egress point. Every Vibe app sends its
# AI traffic here; the router enforces per-task-class data boundaries
# (local_only / cloud_deidentified / cloud_allowed), scrubs protected data
# before any cloud call, holds the firm's provider keys encrypted, and
# writes one cost-ledger row per request.
#
# MASTER_KEY MUST survive across re-renders (lib/enable-app.sh preserves it
# via the _extract_env_value pattern, same as vibe-1099's MASTER_KEY): it
# wraps the per-credential data keys that encrypt every provider API key.
# Losing it does NOT lose client data — the ledger and audit trail are
# unaffected — but every provider key must be re-entered.
#
# It lives in /opt/vibe/env, which is inside the appliance's sealed backup.
# The router's own runbook asks for the master key to be escrowed SEPARATELY
# from the database backup; see the app's docs/runbook.md.

NODE_ENV=production
HOST=0.0.0.0
# NB: PORT and ROUTER_ROLE are set PER SERVICE in apps/vibe-ai-router.yml, not here —
# the same image runs twice: the gateway (ROUTER_ROLE=gateway, :8220, internal only) and
# the admin console (ROUTER_ROLE=console, :8222, the surface Caddy fronts). Compose's
# `environment:` wins over this env_file, so do not set either key here.

# --- Storage (per-app role on shared Postgres) ------------------------
# No REDIS_URL: breaker / rate-limit / response-cache state is in-process
# by design for the single-container appliance (the app's Q-038).
DATABASE_URL=@DATABASE_URL@

# --- Credential vault -------------------------------------------------
# 32 raw bytes, base64. Generated once, preserved on every re-render.
MASTER_KEY=@MASTER_KEY@

# --- Admin console ----------------------------------------------------
# Session signing key. This is the appliance-wide JWT_SECRET from
# shared.env (same convention as vibe-connect / vibe-tx-converter), not a
# per-app value — it signs this console's cookies only. Rotating
# shared.env's JWT_SECRET just signs everyone out.
SESSION_SECRET=@JWT_SECRET@
# Mark session cookies Secure when the appliance serves over HTTPS. For
# THIS app that means domain mode only: in LAN mode it renders false as
# for every app, and in TAILSCALE mode it also renders false — unlike
# other apps — because a rootServedOnly app has no HTTPS path there
# (tailscale serve fronts the path-mounting catch-all this app can't
# join), so its only surface is the plain-HTTP emergency port inside the
# WireGuard tunnel, and a Secure cookie would make sign-in impossible.
# Domain-mode trade-off to know: with Secure=true you cannot SIGN IN over
# the plain-HTTP emergency port (:5193); it stays useful for confirming
# the service is up, but fixing TLS/DNS is the way back into the console.
SECURE_COOKIES=@SESSION_SECURE@
# First-login password, generated once and preserved. Surfaced in the
# console's first-login card and in /opt/vibe/CREDENTIALS.txt's per-app
# section — both read this file live via the manifest's
# firstLogin.passwordEnvKey. Changing it here does NOT change the login:
# the router's bootstrap applies it once, at first enable.
ROUTER_ADMIN_PASSWORD=@ROUTER_ADMIN_PASSWORD@
ROUTER_ADMIN_EMAIL=admin@appliance.local
FIRM_NAME=Firm

# --- The appliance's own model server ---------------------------------
# Every local_only task class is served from here and never leaves the box.
# Must be a LAN/docker address: the router refuses a `local` provider that
# points at a public host, because that would be a covert cloud route
# around the data boundary.
LOCAL_MODEL_BASE_URL=http://vibellm:11434/v1
LOCAL_MODEL_ID=ollama/qwen3:14b
LOCAL_MODEL_CONTEXT=32768
# Capabilities of the served model — these gate which task classes may use
# it (a class needing structured output will not accept a model that lacks
# it, rather than silently degrading).
LOCAL_MODEL_TOOLS=1
LOCAL_MODEL_JSON_SCHEMA=1
LOCAL_MODEL_VISION=0

# --- Catalog ----------------------------------------------------------
# Nightly model/pricing sync from the snapshot vendored inside the image
# (no network egress). Empty string disables it.
CATALOG_SYNC_CRON=15 3 * * *

# --- Data protection --------------------------------------------------
# NOTE: the scrubber mode (redact | block | warn) is FIRM state, not an env
# var — set it in the router's own console under Firm settings. It ships as
# `redact`: protected numbers become [SSN]-style tokens before any cloud
# call. `block` rejects such requests outright.

# --- Egress safety ----------------------------------------------------
# Refuse cloud providers whose base URL resolves to a private/loopback/
# metadata address. Leave on.
SSRF_DENY_PRIVATE_CLOUD=true

# --- Retention --------------------------------------------------------
# usage_ledger rows are metadata only (no prompt bodies, ever) and are kept
# indefinitely by default. Set a day count to purge older rows. The audit
# log is append-only and never purged — it is the firm's compliance record.
# LEDGER_RETENTION_DAYS=

# --- Rate limits / concurrency (defaults suit a single firm) ----------
# RATE_LIMIT_PER_TOKEN_RPM=600
# RATE_LIMIT_PER_USER_RPM=240
# UPSTREAM_MAX_CONCURRENCY=16
