# vibe-files-portal.env.tmpl — rendered to /opt/vibe/env/vibe-files-portal.env
# by lib/enable-app.sh (mode 600). Values the operator sets later (Settings →
# Vibe Portal, or by hand) are kept on every re-render.
#
# Vibe Portal (KisaesDevLab/Vibe-Portal, image ghcr.io/kisaesdevlab/vibe-portal).
# The overlay loads ONLY this file — not shared.env or appliance.env — so the
# appliance-wide EMAIL_PROVIDER / SMS_PROVIDER (which may name providers this
# app does not support) never reach it.

NODE_ENV=production
LOG_LEVEL=info

# The address clients use: https://files.<domain> (its own hostname).
PORTAL_URL=@ALLOWED_ORIGIN@

DATABASE_URL=@DATABASE_URL@

# Encrypted files and the key file .firm-key.seal (bind mount; see the overlay).
DATA_DIR=/data/portal

# Count sign-in limits by CF-Connecting-IP. Caddy sets that header itself on
# this app's vhost (manifest routing.clientIpHeader) and the app has no LAN
# port, so a client cannot choose its own value.
TRUST_CF_CONNECTING_IP=true

# --- Email (REQUIRED) --------------------------------------------------------
# The portal refuses to start without SMTP_HOST and EMAIL_FROM: sign-in links
# and codes go by email.
# TODO(preflight): enable-app cannot check these before the first start,
# because Settings can only write this file once it exists. Until it can, the
# first Enable stops with the app's own "SMTP_HOST: required" message.
EMAIL_PROVIDER=smtp
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Blank: TLS from the start on port 465, STARTTLS otherwise.
SMTP_SECURE=

# --- Texts (optional) --------------------------------------------------------
# none = clients sign in by email only. twilio needs the account SID, auth
# token, and a from number or messaging service SID.
SMS_PROVIDER=none
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
