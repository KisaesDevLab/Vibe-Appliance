# vibe-1040.env.tmpl — rendered to /opt/vibe/env/vibe-1040.env by
# lib/enable-app.sh.
#
# Vibe 1040 reads a client's 1040 source-document bundle and emits a
# worksheet of totals keyed to Form 1040 and schedule line numbers. It
# does not compute tax and does not ingest the prepared return.
#
# Four containers share this one file: the api, the BullMQ worker, the
# migration one-shot, and the Python rasterization sidecar. See
# apps/vibe-1040.yml for the service graph and why all four run as
# uid 10001.
#
# THREE KEYS HERE ARE UNROTATABLE IN PRACTICE and are generated once,
# then preserved verbatim on every re-render (lib/enable-app.sh fills
# any manifest env entry whose `from` is generated:<shape> that way):
#
#   TIN_HASH_SALT           salts the taxpayer join key. Change it and
#                           every stored taxpayer record is orphaned —
#                           not unreadable, ORPHANED: the app can no
#                           longer match a document to the client it
#                           belongs to.
#   STORAGE_ENCRYPTION_KEY  AES-256-GCM for every source document and
#                           page image on disk. Change it and none of
#                           them decrypt.
#   SESSION_SECRET          signs staff session cookies. This one is
#                           genuinely rotatable; rotating it just signs
#                           everyone out of this app.
#
# /opt/vibe/env is inside the appliance's sealed backup set, so a
# restored appliance restores these with it. A blob-store backup taken
# WITHOUT this file is not a backup.

NODE_ENV=production
PORT=8240
LOG_LEVEL=info

# --- Storage (per-app role on shared Postgres; Redis index 8) --------
DATABASE_URL=@DATABASE_URL@
REDIS_URL=@REDIS_URL@

# --- Vibe AI Router (hard dependency, not an option) -----------------
# This app holds NO provider credentials of its own. Every inference
# call — page classification, layout, field extraction — goes through
# the router, so there is no "direct" mode to fall back to the way
# vibe-payroll and vibe-tax-research have one. The token is minted
# against the router's admin API during enable and preserved across
# re-renders; the app's config schema requires it to be non-empty, so
# an unminted token means the api, the worker AND the migration one-shot
# all exit at import time.
#
# That is why the manifest lists vibe-ai-router under requiredApps:
# enable-app refuses up front and names the app to turn on, rather than
# letting you read four crash loops to find out.
VIBE_AI_ROUTER_URL=http://vibe-ai-router:8220
VIBE_AI_TOKEN=@VIBE_AI_TOKEN@

# Region pinning — READ THIS BEFORE PROCESSING LIVE CLIENT DATA.
#
# Upstream ships ROUTER_REQUIRE_US_REGION=true: at startup the app asks
# the router whether its three task classes are pinned to US inference
# and REFUSES TO START if they are not. The appliance ships it FALSE,
# because as of vibe-ai-router v0.0.2 the router has no region concept
# at all — there is no /v1/policy/regions to answer, so leaving the
# assertion on means Vibe 1040 never boots on this appliance.
#
# What you are accepting by leaving this false: the app's task classes
# are `cloud_deidentified`, and the router's scrubber cannot scrub image
# parts — a rasterized W-2 is a picture of a W-2. The region assertion
# was the control that kept those page images inside US inference. With
# it off, the control that remains is which providers you have enabled
# in the router console and where they run.
#
# Keeping taxpayer images entirely on the appliance is the alternative
# available today: leave this app's task classes at `local_only` in the
# router console (that is what registration creates them as) and they
# are served by the appliance's own model server. The startup log tells
# you which way each class resolved, every boot.
ROUTER_REQUIRE_US_REGION=false
# What the app EXPECTS its classes to be, for the startup report only —
# a mismatch is a warning, never a refusal. Left at the upstream value
# so the log actively tells you when a class is still local_only and a
# firm admin has not yet widened it in the router console.
ROUTER_EXPECTED_SENSITIVITY=cloud_deidentified

# --- Key material (generated once, preserved across re-renders) ------
# 32 raw bytes each, base64. See the header.
TIN_HASH_SALT=@TIN_HASH_SALT@
SESSION_SECRET=@SESSION_SECRET@
STORAGE_ENCRYPTION_KEY=@STORAGE_ENCRYPTION_KEY@

# --- Blob storage ----------------------------------------------------
# Local driver, bind-mounted from /opt/vibe/data/apps/vibe-1040/blobs and
# shared by the api, the worker, and the sidecar. To move the store to
# Backblaze B2 instead, set STORAGE_DRIVER=b2 and add B2_BUCKET,
# B2_ENDPOINT, B2_REGION, B2_KEY_ID, B2_APPLICATION_KEY below — those
# keys are not in this template, so the render's merge step preserves
# them. This is a copy-paste edit (sudo nano /opt/vibe/env/vibe-1040.env),
# not a console button.
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=/data/blobs

# --- Python sidecar --------------------------------------------------
# Concurrent rasterization jobs. Each one holds a full page bitmap in
# memory; 2 is right for the 2 GB reference droplet.
SIDECAR_CONCURRENCY=2

# --- First login -----------------------------------------------------
# The appliance's seed step runs `node dist/db/seed.js` in the api
# container exactly once (state.apps.vibe-1040.seeded gates it) and
# creates ONE staff admin from these two values. It creates no demo
# data and pre-enrols no second factor — MFA enrolment happens in the UI
# on first sign-in, which is the point.
#
# Change the email BEFORE the first enable if you want a real address:
# afterwards the account exists and this value is inert. The password is
# generated once, preserved across re-renders, and surfaced in the
# console's First-login card and /opt/vibe/CREDENTIALS.txt.
SEED_ADMIN_EMAIL=admin@appliance.local
SEED_ADMIN_PASSWORD=@SEED_ADMIN_PASSWORD@

# --- Licensing -------------------------------------------------------
# licensing.kisaes.com enforcement is later-phase; ships off.
LICENSE_REQUIRED=0

# --- Operator-set via Settings (manifest ui blocks) ------------------
# DELIBERATELY ABSENT from this template, so an edit made on the admin
# Settings page survives the next enable — anything this file names is
# rewritten from the template on every render, while anything it does
# not name is carried forward by the merge step:
#
#   RECONCILE_TOLERANCE_CENTS   arithmetic gate tolerance   (app default 100)
#   EXTRACT_PASSES              extraction passes per doc   (app default 2)
#   RETENTION_RASTER_DAYS       page-image retention        (app default 90)
#   RETENTION_DOCUMENT_DAYS     source-document retention   (app default 2555)
#   TZ                          inherited from appliance.env
#
# Each app default already equals the default the manifest advertises,
# so leaving them unset here changes nothing until an operator sets one.
# SEED_ADMIN_EMAIL is the one exception above: it has to match the
# username the First-login card prints, and upstream's own default
# (admin@example.test) does not.
#
# --- Appliance-owned ingress (do NOT enable an in-app tunnel) --------
# The appliance's shared Caddy + Cloudflare Tunnel own public ingress.
# This app is served at the ROOT of its own subdomain in both routing
# modes (manifest rootServedOnly — its bundle asks for assets at the
# host root and has no base-path switch), or on emergency port 5177 in
# LAN/Tailscale mode.
