# vibe-1099.env.tmpl — rendered to /opt/vibe/env/vibe-1099.env by
# lib/enable-app.sh.
#
# Vibe 1099 = 1099 prep + recipient delivery + IRS IRIS A2A e-filing.
# The monorepo image `vibe1099-app` runs BOTH the api (8210) and the
# worker; `vibe1099-web` is the nginx SPA (8211) that fronts /api;
# `vibe1099-render` is the internal WeasyPrint PDF sidecar (8212).
# See apps/vibe-1099.yml for the service graph.
#
# MASTER_KEY MUST survive across re-renders (lib/enable-app.sh preserves
# it via the _extract_env_value pattern, same as vibe-shield's VS_KEK):
# it derives every purpose key that encrypts TINs, JWKs, and W-9 PDFs.
# Losing it = losing all encrypted data. It lives in /opt/vibe/env, which
# is part of the appliance's sealed backup.

NODE_ENV=production

# --- Crypto (generated once, preserved across re-renders) -------------
# 32 raw bytes, base64. NEVER rotate directly — see the app's
# docs/key-rotation.md, which re-wraps every derived key under the new one.
MASTER_KEY=@MASTER_KEY@

# --- Storage (per-app role on shared Postgres; isolated Redis index 7) -
DATABASE_URL=@DATABASE_URL@
REDIS_URL=@REDIS_URL@

# --- First login (created by the production bootstrap, PR #5) ---------
# The appliance's seed step runs `pnpm bootstrap:firm` in the api
# container: real firm + this one admin, NO demo data (never run `pnpm
# seed` in production — demo TINs and a published password). Password is
# generated once and preserved across re-renders; surfaced in the
# console's First-login card and /opt/vibe/CREDENTIALS.txt. Change the
# email BEFORE first enable if you want a real address. Requires a
# Vibe-1099 release containing PR #5; on older images the seed fails
# soft and retries at the next enable.
VIBE1099_ADMIN_EMAIL=admin@appliance.local
VIBE1099_ADMIN_PASSWORD=@VIBE1099_ADMIN_PASSWORD@
FIRM_NAME=Firm

# --- Service wiring ---------------------------------------------------
API_PORT=8210
# Internal WeasyPrint render sidecar, reached over the per-app network
# (vibe-1099-render is aliased `render` there).
RENDER_URL=http://render:8212

# --- Public base URLs -------------------------------------------------
# Staff/client app + recipient portal both resolve to this app's host.
# The manifest marks this app rootServedOnly (its root-base SPA can't be
# path-mounted), so in domain mode this renders https://1099.<domain>/ in
# BOTH routing modes, and in LAN/Tailscale mode it renders the emergency-
# port origin (http://<ip>:5176). Front the portal on its own subdomain
# later if you want the staff app private and only the portal public.
APP_BASE_URL=@ALLOWED_ORIGIN@
PORTAL_BASE_URL=@ALLOWED_ORIGIN@
# Permit the http:// form of the base URLs in production. Upstream's boot
# validation is https-only by default; this opt-out exists for exactly the
# appliance's LAN mode (office network only) and Tailscale mode (plain
# HTTP inside WireGuard) — there is no public hop in either. Harmless in
# domain mode, where the URLs are https and the flag is moot. Provider/IRS
# endpoints stay https-only regardless. NB: requires a Vibe-1099 release
# containing ALLOW_HTTP_BASE_URLS (PR #4); the v0.1.0 images ignore the
# key and still refuse http — see docs/DEPLOYMENT_CHECKLIST.md.
ALLOW_HTTP_BASE_URLS=1

# --- Appliance-owned ingress (do NOT enable the in-app tunnel) --------
# The appliance's shared Caddy + Cloudflare Tunnel own public ingress.
# Never start Vibe 1099's own cloudflared sidecar on the appliance.
INAPP_TUNNEL_ENABLED=0
# Reverse-proxy hop count in front of the api (appliance Caddy + the
# web-tier nginx). Must match the real topology or per-IP rate limits
# key off a spoofable X-Forwarded-For.
TRUST_PROXY_HOPS=2

# --- Licensing --------------------------------------------------------
# licensing.kisaes.com enforcement is later-phase; ships off.
LICENSE_REQUIRED=0

# --- Compliance / sessions (app defaults; override per firm) ----------
DATA_RETENTION_YEARS=4
SESSION_INACTIVITY_MINUTES=30
SESSION_ABSOLUTE_HOURS=12

# --- Migration gating -------------------------------------------------
# Vibe 1099 auto-runs migrations on boot (advisory-locked, safe for the
# concurrent api+worker start). The appliance does not gate them — like
# vibe-connect and vibe-glm-ocr there's no explicit-migrate step; update.sh's
# pre-update DB backup + health-check rollback is the safety net. (No
# MIGRATIONS_AUTO knob exists upstream to flip.)

# --- Email / SMS (inherited from appliance.env where names match) -----
# Vibe 1099 reads SMTP_HOST / SMTP_PORT / SMTP_USER + EMAIL_PROVIDER /
# EMAILIT_API_KEY + SMS_PROVIDER / TEXTLINK_API_KEY / TWILIO_* — the same
# names the appliance's Email & SMS settings write to appliance.env, so
# those inherit automatically (appliance.env is loaded before this file).
# TWO names differ and must be set here if you use SMTP: the appliance
# stores the SMTP password as SMTP_PASSWORD and the from-address as
# EMAIL_FROM, while Vibe 1099 reads SMTP_PASS + SMTP_FROM. Uncomment:
# SMTP_PASS=
# SMTP_FROM=Your Firm <no-reply@your-firm.example>

# --- Operator-set via Settings (manifest ui blocks) -------------------
# STAFF_IP_ALLOWLIST and TAXBANDITS_ENABLED are surfaced on the admin
# Settings page. When set there, settings-save appends them below; unset,
# the app uses its own defaults (no IP gating; TaxBandits off).
