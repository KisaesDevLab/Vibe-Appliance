# vibe-tx-converter.env.tmpl — rendered to /opt/vibe/env/vibe-tx-converter.env
# by lib/enable-app.sh.
#
# The Convertor reads DATABASE_URL + REDIS_URL directly. SESSION_SECRET
# must be at least 32 bytes; we alias the appliance-wide JWT_SECRET
# (already 32 bytes of hex) rather than generating a parallel secret.
#
# LLM provider routing:
#   LLM_PROVIDER=anthropic + ANTHROPIC_API_KEY  → uses Claude (appliance default)
#   LLM_PROVIDER=local     + LLM_GATEWAY_URL    → external local LLM server
# The appliance does not currently ship an in-network LLM gateway, so
# the default below is anthropic. Operators with their own local LLM
# server (Ollama, llama.cpp, vibe-llm-server) can flip this and supply
# the URL.

NODE_ENV=production
PORT=4000

# --- Routing identity -------------------------------------------------
ALLOWED_ORIGIN=@ALLOWED_ORIGIN@
WEB_BASE_URL=@ALLOWED_ORIGIN@

# Vite SPA base-path — must match the Caddy prefix (`/<slug>/` in
# LAN/Tailscale, `/` in domain mode).
VITE_BASE_PATH=@VITE_BASE_PATH@

# --- Sessions ---------------------------------------------------------
SESSION_SECRET=@JWT_SECRET@
# SESSION_SECURE marks the session + CSRF cookies with the `Secure`
# flag, which makes the browser only send them over HTTPS. The
# appliance computes this from the install mode (true under
# domain/tailscale where TLS terminates at the ingress, false under
# lan HTTP) — see lib/enable-app.sh's _render_app_env. Hardcoding
# `true` would break LAN installs (browser silently drops the cookie
# on every request after login); hardcoding `false` would weaken
# HTTPS deploys. Honored upstream by apps/api/src/lib/cookie-flags.ts.
SESSION_SECURE=@SESSION_SECURE@

# --- Data plane ------------------------------------------------------
DATABASE_URL=@DATABASE_URL@
REDIS_URL=@REDIS_URL@

# --- Storage --------------------------------------------------------
DATA_DIR=/var/lib/vibetc
MAX_UPLOAD_MB=25
MAX_BATCH_SIZE=100

# --- GLM-OCR (cross-app) ---------------------------------------------
# vibe-glm-ocr is NO LONGER bundled in the appliance, so the OCR path is
# unconfigured by default — OCR-requiring requests fail with a clear
# upstream error until you point GLM_OCR_URL at an OCR service you host
# yourself (e.g. a GPU-rebuilt GLM-OCR image reachable from vibe_net).
# Uncomment and set the URL to enable; the tuning knobs below apply once
# it's set (180s margins dense multi-page statements; lower toward 60000
# for GPU inference).
# GLM_OCR_URL=http://<your-ocr-host>:8090
GLM_OCR_TIMEOUT_MS=180000
GLM_OCR_CONCURRENCY=2
GLM_OCR_CACHE_TTL_DAYS=7

# --- LLM provider ---------------------------------------------------
# Anthropic via the appliance's own key (Settings → AI). Override per-app
# in this file or via the admin Settings page if you've configured a
# local LLM gateway.
LLM_PROVIDER=anthropic
LLM_TIMEOUT_MS=60000
LLM_MAX_PROMPT_TOKENS=24000
LLM_MAX_COMPLETION_TOKENS=6000
LLM_CACHE_TTL_HOURS=24

# --- Worker / appliance ---------------------------------------------
WORKER_INLINE=true
APPLIANCE_MODE=true
APPLIANCE_VERSION=1

# --- Migrations -----------------------------------------------------
# True so the API self-migrates on first boot. Honored upstream by
# apps/api/src/index.ts (v0.1.5+). enable-app.sh deliberately does NOT
# run migrations.command explicitly on first-enable — only update.sh
# does, behind a pre-update DB dump for rollback safety. So this flag
# is what creates the schema the very first time vibe-tx-converter
# comes up.
MIGRATIONS_AUTO=true

# --- Optional knobs (override via 'sudo nano /opt/vibe/env/vibe-tx-converter.env') ---
# ANTHROPIC_API_KEY=     # inherited from appliance.env
# ANTHROPIC_MODEL=       # inherited from appliance.env
# ANTHROPIC_BASE_URL=https://api.anthropic.com
#
# To switch to a local LLM gateway (Ollama / llama.cpp / vibe-llm-server):
#   LLM_PROVIDER=local
#   LLM_GATEWAY_URL=http://your-llm-host:11434
#   LLM_MODEL_ID=qwen3-8b

# --- Vibe AI Router (dual-mode, MIG-6) ---
# Rendered by `vibe enable`: mode becomes "router" with a minted app token
# when the vibe-ai-router app is enabled and healthy at enable time;
# otherwise "direct" (re-enable this app after the router is up to switch).
# router mode moves model choice, scrubbing, budgets, and cost tracking to
# the router console; the app's own AI provider settings become inert.
VIBE_AI_MODE=@VIBE_AI_MODE@
VIBE_AI_ROUTER_URL=http://vibe-ai-router:8220
VIBE_AI_TOKEN=@VIBE_AI_TOKEN@
