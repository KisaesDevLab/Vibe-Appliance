#!/usr/bin/env bash
# bin/vibe — thin CLI wrapper for the Vibe Appliance.
#
# Symlinked into /usr/local/bin/vibe by bootstrap.sh so the operator can
# type `vibe doctor` instead of the full path. Subcommands dispatch to
# the existing scripts under /opt/vibe/appliance — they're the source of
# truth.
#
# Idempotency: read-only wrapper; running it doesn't mutate state beyond
#   what the dispatched script already does.
# Reverse: rm /usr/local/bin/vibe.

set -euo pipefail

APPLIANCE_DIR="${APPLIANCE_DIR:-/opt/vibe/appliance}"

usage() {
  cat <<'EOF'
vibe — Vibe Appliance command-line interface.

USAGE
  vibe <command> [args]

COMMANDS
  doctor [--json]              Run diagnostics and print PASS/WARN/FAIL.
  enable  <slug>               Bring an app online.
  disable <slug>               Take an app offline (data preserved).
  update  --check [slug]       Check for available image updates.
  update  <slug>               Update an app (pre-update DB backup +
                               rollback on failure).
  update  <slug> --rollback    Roll back to the prior image.
  status                       Print the current state.json snapshot.
  credentials                  Print /opt/vibe/CREDENTIALS.txt to stdout.
                               Pipe-friendly for SSH-based download:
                                 ssh host 'sudo vibe credentials' > local.txt
  logs   [name]                Tail /opt/vibe/logs/<name>.log
                               (defaults to bootstrap.log).
  cookies [--status]           Show whether session cookies carry the
                               Secure flag, and why.
  cookies --lan-only           Allow cookies to drop Secure so the
                               plain-HTTP emergency ports are usable for
                               sign-in. Refused unless those ports are
                               verifiably firewalled to RFC1918 +
                               Tailscale CGNAT.
  cookies --secure             Revoke the above; restore Secure cookies.
  bootstrap [args…]            Re-run the full bootstrap.
  uninstall [--remove-data | --full]
                               Tear down the appliance. Default keeps data;
                               --remove-data nukes /opt/vibe; --full also
                               removes Docker / Cockpit / Tailscale / Avahi.

EOF
}

cmd="${1:-}"
[[ -n "$cmd" ]] || { usage; exit 2; }
shift || true

case "$cmd" in
  doctor)
    exec "${APPLIANCE_DIR}/doctor.sh" "$@"
    ;;
  enable)
    exec /bin/bash "${APPLIANCE_DIR}/lib/enable-app.sh" "$@"
    ;;
  disable)
    exec /bin/bash "${APPLIANCE_DIR}/lib/disable-app.sh" "$@"
    ;;
  update)
    exec /bin/bash "${APPLIANCE_DIR}/update.sh" "$@"
    ;;
  status)
    if [[ -r /opt/vibe/state.json ]]; then
      cat /opt/vibe/state.json
    else
      echo "no state.json yet — has bootstrap run?" >&2
      exit 1
    fi
    ;;
  credentials|creds)
    # Print CREDENTIALS.txt to stdout. The file is mode 600 root-owned
    # so this needs sudo. The pipe-friendly invocation is the whole
    # point — operators do `ssh host 'sudo vibe credentials' > local.txt`
    # to grab the file from a workstation without sftp gymnastics.
    file="/opt/vibe/CREDENTIALS.txt"
    if [[ ! -e "$file" ]]; then
      echo "no $file yet — bootstrap hasn't completed phase 8 (credentials)" >&2
      exit 1
    fi
    if [[ ! -r "$file" ]]; then
      echo "$file exists but is not readable by uid $(id -u). Run via sudo:" >&2
      echo "  sudo vibe credentials" >&2
      exit 1
    fi
    exec cat "$file"
    ;;
  logs)
    name="${1:-bootstrap}"
    file="/opt/vibe/logs/${name}.log"
    if [[ ! -r "$file" ]]; then
      echo "no such log: $file" >&2
      echo "available logs:" >&2
      ls /opt/vibe/logs/ 2>/dev/null >&2 || true
      exit 1
    fi
    exec tail -f -n 200 "$file"
    ;;
  cookies)
    # Session-cookie policy. Reading status is safe for anyone; changing it
    # writes state.json and is root-only, same as every other mutating
    # subcommand here.
    # shellcheck source=/dev/null
    . "${APPLIANCE_DIR}/lib/log.sh"
    # shellcheck source=/dev/null
    . "${APPLIANCE_DIR}/lib/state.sh"
    # shellcheck source=/dev/null
    . "${APPLIANCE_DIR}/lib/lan-only-cookies.sh"
    case "${1:---status}" in
      --status|status|"")
        if lan_only_cookies_consented; then
          echo "opt-in:    RECORDED ($(state_get_config_kv lan_only_cookies_actor) at $(state_get_config_kv lan_only_cookies_at))"
        else
          echo "opt-in:    not recorded — cookies keep the Secure flag"
        fi
        if lan_only_cookies_verify; then
          echo "firewall:  VERIFIED — emergency ports restricted to RFC1918 + Tailscale CGNAT"
        else
          echo "firewall:  NOT VERIFIED"
          # `verify --explain` exits non-zero by design, and `set -o pipefail`
          # propagates that through the pipe. Without `|| true` the shell's
          # `set -e` kills a purely informational command mid-report.
          lan_only_cookies_verify --explain | sed 's/^/           - /' || true
        fi
        if lan_only_cookies_active; then
          echo "effective: cookies render WITHOUT Secure (sign-in works on the emergency ports)"
        else
          echo "effective: cookies render WITH Secure"
          if lan_only_cookies_consented; then
            echo "           (opt-in is recorded but unverified, so it is NOT being applied)"
          fi
        fi
        # `vibe cookies --status` reports; it does not pass judgement. Exiting
        # non-zero here would make callers — the console's runOnHost among them
        # — read a healthy appliance as a failed command.
        exit 0
        ;;
      --lan-only)
        [[ $EUID -eq 0 ]] || { echo "vibe cookies --lan-only must run as root (sudo)" >&2; exit 1; }
        if ! reasons="$(lan_only_cookies_verify --explain)"; then
          echo "Refusing: the emergency ports are not verifiably restricted." >&2
          sed 's/^/  - /' <<<"$reasons" >&2
          echo "  fix: sudo bash ${APPLIANCE_DIR}/lib/ufw-rules.sh, then retry." >&2
          echo "  why: without that firewall the plain-HTTP surface is public, and dropping" >&2
          echo "       the Secure flag would expose session cookies to the internet." >&2
          exit 1
        fi
        lan_only_cookies_record true "cli:vibe cookies --lan-only"
        echo "Recorded. Session cookies will render without the Secure flag."
        echo "Applies on the next enable: sudo vibe disable <slug> && sudo vibe enable <slug>"
        echo "Revoke with: sudo vibe cookies --secure"
        ;;
      --secure)
        [[ $EUID -eq 0 ]] || { echo "vibe cookies --secure must run as root (sudo)" >&2; exit 1; }
        lan_only_cookies_record false "cli:vibe cookies --secure"
        echo "Revoked. Session cookies will render with the Secure flag."
        echo "Applies on the next enable: sudo vibe disable <slug> && sudo vibe enable <slug>"
        ;;
      *)
        echo "usage: vibe cookies [--status | --lan-only | --secure]" >&2
        exit 2
        ;;
    esac
    ;;
  bootstrap)
    exec sudo "${APPLIANCE_DIR}/bootstrap.sh" "$@"
    ;;
  uninstall)
    exec sudo "${APPLIANCE_DIR}/uninstall.sh" "$@"
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    echo "unknown command: $cmd" >&2
    usage >&2
    exit 2
    ;;
esac
