# Force LF line endings for everything that ships to or runs on the host.
# Without this, Windows clones convert LF→CRLF and the bash scripts break
# on Linux (shebang lookup fails: "/usr/bin/env bash\r" not found).
*.sh        text eol=lf
*.bash      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.tmpl      text eol=lf
*.conf      text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.js        text eol=lf
*.mjs       text eol=lf
*.cjs       text eol=lf
*.env       text eol=lf
Dockerfile  text eol=lf
LICENSE     text eol=lf
VERSION     text eol=lf
.gitignore  text eol=lf
.gitattributes text eol=lf

# Anything with no extension under bin/ or scripts/ — also LF.
bin/*       text eol=lf
scripts/*   text eol=lf
*.py        text eol=lf

# Release tarball exclusions (tools/release.sh builds from `git archive`,
# which honours export-ignore). These are build-plan notes, tests and CI —
# nothing on a customer box reads them at runtime. The operator CLAUDE.md
# shipped in releases comes from release/CLAUDE.operator.md instead.
CLAUDE.md               export-ignore
docs/PLAN.md            export-ignore
docs/PHASES.md          export-ignore
docs/RELEASE_v1.md      export-ignore
standby/CLAUDE.md       export-ignore
standby/PHASES.md       export-ignore
standby/STATE.md        export-ignore
standby/QUESTIONS.md    export-ignore
standby/test            export-ignore
tests                   export-ignore
.github                 export-ignore
.claude                 export-ignore
release                 export-ignore
tools/release.sh        export-ignore
tools/release-build.py  export-ignore
