# Editor / OS noise
.DS_Store
Thumbs.db
*.swp
*~
.vscode/
.idea/

# Claude Code local config (per-developer; never committed)
.claude/

# Local environment overrides — never commit
.env
.env.local
*.local

# Host-specific compose overrides. This is the supported way to customise
# a single appliance: keep the tracked files pristine so `git pull` and the
# console's self-update button keep working. See docs/LOCAL_OVERRIDES.md.
docker-compose.override.yml
docker-compose.override.yaml
apps/*.override.yml
apps/*.override.yaml

# Per-host runtime artifacts that should never be committed
# (these live under /opt/vibe on the host; if a developer ever drops a
# symlink or copy into the repo, ignore it)
state.json
CREDENTIALS.txt
logs/
data/
env/

# Console build artefacts (filled in Phase 2+)
console/node_modules/
console/dist/
console/*.sqlite
# No lockfile by convention — the image build runs `npm install` from
# package.json alone (see console/Dockerfile).
console/package-lock.json
console/*.sqlite-journal

# Backup / scratch files Claude or shell may leave behind
*.bak
*.bak.*
*.orig
*.tmp
